Options -Indexes
DirectorySlash Off
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Multiple slashes -> single slash (MUST be before REDIRECT_STATUS check)
RewriteCond %{THE_REQUEST} \s[^\s]*//
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Skip rewrite rules for error documents (prevents redirect loops)
RewriteCond %{ENV:REDIRECT_STATUS} !^$
RewriteRule ^ - [L]

# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Add trailing slash ONLY if /slug/index.html actually exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^([a-z0-9-/]+)$ https://betandreasscasino.com/$1/ [R=301,L]

# Directory without trailing slash -> add it
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://betandreasscasino.com/$1/ [R=301,L]

# Redirect /index.html to /
RewriteRule ^index\.html$ https://betandreasscasino.com/ [R=301,L]

# Redirect .html to /slug/ ONLY if /slug/index.html actually exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/([a-z0-9-]+)\.html$
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([a-z0-9-]+)\.html$ https://betandreasscasino.com/$1/ [R=301,L]

# Internal rewrite to index.html ONLY if it exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([a-z0-9/-]+)/?$ /$1/index.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options  "nosniff"
  Header always set X-Frame-Options         "SAMEORIGIN"
  Header always set Referrer-Policy         "strict-origin-when-cross-origin"
  Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"

  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Order Allow,Deny
  Deny from all
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>